# Variables du front (Vite). Copier ce fichier en .env.local, ignoré par git, et le remplir.
# Seule la clé publishable va dans le front : jamais la clé secrète ni service_role.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Ouverture publique de l'inscription (lu au build). Vide ou absent : fermé, l'accueil et /noter
# affichent « Inscriptions bientôt ouvertes » sans lien. Seule la valeur true l'ouvre : à poser
# uniquement après activation du captcha Auth, SMTP, confirmation du consentement et recette.
# Ce drapeau n'est pas une protection de l'API Auth : enable_signup reste false dans config.toml.
VITE_INSCRIPTION_OUVERTE=false
# Clé publique Cloudflare Turnstile (site autorisé pour le domaine déployé).
VITE_TURNSTILE_SITE_KEY=
# Secret de validation Turnstile côté serveur et pour la configuration Supabase Auth.
# Ne jamais utiliser une clé de test Cloudflare en production.
TURNSTILE_SECRET_KEY=

# Supervision du serveur Railway. La clé service_role reste exclusivement dans les variables du
# service serveur (jamais préfixée VITE_) ; sans elle, les métriques restent visibles en direct mais
# l'historique serveur n'est pas persisté. Les bornes ci-dessous sont optionnelles.
SUPABASE_SERVICE_ROLE_KEY=
# Option locale seulement ; sur Railway, RAILWAY_REPLICA_ID distingue automatiquement les instances.
SUPERVISION_INSTANCE_ID=
SUPERVISION_FETCH_TIMEOUT_MS=5000
SUPERVISION_MAX_CONCURRENT=4
SUPERVISION_RATE_LIMIT_PER_MINUTE=60

# Contact : l'API refuse tout dépôt sans clé service_role et secret Turnstile ci-dessus.
# Origine exacte du site, également autorisée dans le widget Turnstile.
CONTACT_ORIGIN=https://olympiademanade-production.up.railway.app
# N'activer la confiance proxy que si l'ingress remplace/assainit X-Forwarded-For.
CONTACT_TRUST_PROXY=false
CONTACT_RATE_IP_LIMIT=3
CONTACT_RATE_GLOBAL_LIMIT=10
CONTACT_RATE_MAX_IPS=10000

# File durable des notes : activer après migration et configuration de la clé serveur ci-dessus.
# Laisser false en développement/test connecté au projet de production.
FILE_NOTES_ACTIVE=false
FILE_NOTES_BATCH_SIZE=100
FILE_NOTES_INTERVAL_MS=250
FILE_NOTES_TIMEOUT_MS=5000
