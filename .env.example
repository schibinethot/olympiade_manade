# Variables du front (Vite). Copier ce fichier en .env.local, ignoré par git, et le remplir.
# Seule la clé publishable va dans le front : jamais la clé secrète ni service_role.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Ouverture publique de l'inscription (lu au build). Vide ou absent : fermé, l'accueil et /noter
# affichent « Inscriptions bientôt ouvertes » sans lien. Seule la valeur true l'ouvre : à poser
# uniquement après activation du captcha Auth, SMTP, confirmation du consentement et recette.
# Ce drapeau n'est pas une protection de l'API Auth : enable_signup reste false dans config.toml.
VITE_INSCRIPTION_OUVERTE=false
# Clé publique Cloudflare Turnstile (site autorisé pour le domaine déployé).
VITE_TURNSTILE_SITE_KEY=
# Secret de validation Turnstile côté serveur et pour la configuration Supabase Auth.
# Ne jamais utiliser une clé de test Cloudflare en production.
TURNSTILE_SECRET_KEY=

# Supervision du serveur Railway. La clé service_role reste exclusivement dans les variables du
# service serveur (jamais préfixée VITE_) ; sans elle, les métriques restent visibles en direct mais
# l'historique serveur n'est pas persisté. Les bornes ci-dessous sont optionnelles.
SUPABASE_SERVICE_ROLE_KEY=
# Option locale seulement ; sur Railway, RAILWAY_REPLICA_ID distingue automatiquement les instances.
SUPERVISION_INSTANCE_ID=
SUPERVISION_FETCH_TIMEOUT_MS=5000
SUPERVISION_MAX_CONCURRENT=4
SUPERVISION_RATE_LIMIT_PER_MINUTE=60

# Contact : l'API refuse tout dépôt sans clé service_role et secret Turnstile ci-dessus.
# Origine exacte du site, également autorisée dans le widget Turnstile.
CONTACT_ORIGIN=https://olympiadedesmanades.fr
# N'activer la confiance proxy que si l'ingress remplace/assainit X-Forwarded-For.
CONTACT_TRUST_PROXY=false
CONTACT_RATE_IP_LIMIT=3
CONTACT_RATE_GLOBAL_LIMIT=10
CONTACT_RATE_MAX_IPS=10000

# Identifiant Google Tag Manager (format GTM-XXXX). Vide ou absent : aucune balise n'est
# chargée côté front, et la CSP du serveur reste fermée aux hôtes GTM/GA/Facebook. Dès que
# cette variable est renseignée au démarrage, la CSP de page étend script-src, connect-src
# et img-src pour Google Tag Manager, Google Analytics et Meta Pixel.
VITE_GTM_ID=

# Collecte des actualités (même origine et clés Turnstile que le contact).
# Sur Railway uniquement : X-Real-IP est réécrit par l’ingress ; ailleurs laisser false.
ACTUALITES_TRUST_RAILWAY_PROXY=false
# Plafonds par période de 10 minutes, distincts du formulaire de contact.
ACTUALITES_RATE_IP_LIMIT=3
ACTUALITES_RATE_GLOBAL_LIMIT=1000
ACTUALITES_RATE_MAX_IPS=10000

# File durable des notes : activer après migration et configuration de la clé serveur ci-dessus.
# Laisser false en développement/test connecté au projet de production.
FILE_NOTES_ACTIVE=false
FILE_NOTES_BATCH_SIZE=100
FILE_NOTES_INTERVAL_MS=250
FILE_NOTES_TIMEOUT_MS=5000

# Instantané public de la soirée (accueil, classements 2027, écran). Faux par défaut :
# le site reste hors soirée même si une soirée « en cours » existe en base.
# true : le serveur recalcule etat_soiree au plus toutes les 5 s (clé service_role requise)
# et /api/etat-soiree sert cet instantané. Ne pas l'activer sur la vitrine publique
# tant que la soirée n'est pas prête. N'ouvre pas les inscriptions.
ETAT_SOIREE_REEL=false

# Email du formulaire de contact vers l'organisateur.
# off (défaut) : dépôt en base seulement, comme avant.
# log : journalise le message côté serveur, sans identifiants (recette).
# smtp : envoi réel. Ne jamais committer les secrets.
SMTP_MODE=off
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
CONTACT_EMAIL_FROM=
CONTACT_EMAIL_TO=
# En mode smtp, le message part vers CONTACT_EMAIL_TO avec Reply-To = l'email du visiteur.
# Ne jamais committer les secrets. L'envoi des codes d'inscription est celui de Supabase Auth
# (bloc commenté dans supabase/config.toml), distinct de ce SMTP de contact.

# Web Push (CDC notifications). Sans les deux clés, aucun envoi : la bannière dans l'app reste le secours.
# Générer une paire : npx web-push generate-vapid-keys
# VAPID_SUBJECT : mailto: ou https:// de contact. VITE_VAPID_PUBLIC_KEY reprend la clé publique (elle est publique).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contact@olympiade-manade.local
VITE_VAPID_PUBLIC_KEY=

# Lecture des PDF et photos de planning. Sans clé, l'import renvoie un brouillon vide à saisir.
# Le fichier n'est pas conservé. Ne jamais committer la clé.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# Accès réservé prélancement : tout le site est fermé sauf aux ordinateurs ayant ouvert une
# fois l'URL `/?acces=<ACCES_TOKEN>`. Variable vide ou absente : barrière désactivée (dev
# local, tests). Longueur minimale : 32 caractères (sinon le serveur refuse de démarrer).
# Générer : `openssl rand -hex 24` (48 caractères hexadécimaux).
ACCES_TOKEN=
