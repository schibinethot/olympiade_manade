# Variables du front (Vite). Copier ce fichier en .env.local, ignoré par git, et le remplir.
# Seule la clé publishable va dans le front : jamais la clé secrète ni service_role.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Ouverture publique de l'inscription (lu au build). Vide ou absent : fermé, l'accueil et /noter
# affichent « Inscriptions bientôt ouvertes » sans lien. Seule la valeur true l'ouvre : à poser
# une fois le SMTP personnalisé de Supabase configuré.
VITE_INSCRIPTION_OUVERTE=

# Supervision du serveur Railway. La clé service_role reste exclusivement dans les variables du
# service serveur (jamais préfixée VITE_) ; sans elle, les métriques restent visibles en direct mais
# l'historique serveur n'est pas persisté. Les bornes ci-dessous sont optionnelles.
SUPABASE_SERVICE_ROLE_KEY=
# Option locale seulement ; sur Railway, RAILWAY_REPLICA_ID distingue automatiquement les instances.
SUPERVISION_INSTANCE_ID=
SUPERVISION_FETCH_TIMEOUT_MS=5000
SUPERVISION_MAX_CONCURRENT=4
SUPERVISION_RATE_LIMIT_PER_MINUTE=60
