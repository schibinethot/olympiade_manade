{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "rootDirs": [".", "./.react-router/types"],
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "verbatimModuleSyntax": true,
    "allowJs": true,
    "types": ["node", "vite/client"]
  },
  "include": [
    "app",
    "serveur",
    "tests",
    ".react-router/types/**/*",
    "vitest.config.ts",
    "vite.config.ts",
    "react-router.config.ts",
    "playwright.config.ts"
  ]
}
